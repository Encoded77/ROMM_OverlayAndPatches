+class OverlayExtensionPayload(BaseModel):
+    enabled: bool
+
+
+@protected_route(
+    router.put, "/overlay/extensions/{extension_id}", [Scope.USERS_WRITE]
+)
+async def update_overlay_extension(
+    request: Request,
+    payload: OverlayExtensionPayload,
+    extension_id: str = Path(pattern=r"^[a-z0-9][a-z0-9-]{0,63}$"),
+) -> None:
+    """Switch one overlay extension on or off (overlay.extensions in config.yml)"""
